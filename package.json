{
  "name": "relaylab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "downstream",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n coordinator,downstream,client -c blue,magenta,green \"npm run dev -w server\" \"npm run dev -w downstream\" \"npm run dev -w client\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
