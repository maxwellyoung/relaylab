# Coordinator API
PORT=3000
RELAYLAB_DATA_DIR=/absolute/path/to/relaylab-data
DOWNSTREAM_URL=http://127.0.0.1:3001
DOWNSTREAM_TIMEOUT_MS=400

# Persistence: SQLite is the default when this remains unset.
# To use the lecturer-provided server, copy this file to .env and set these
# values locally. Never commit the real username or password.
RELAYLAB_DATABASE_DRIVER=sqlite
RELAYLAB_DB_HOST=database.example.test
RELAYLAB_DB_PORT=3306
RELAYLAB_DB_NAME=student_schema
RELAYLAB_DB_USER=student_username
RELAYLAB_DB_PASSWORD=local-secret-only
RELAYLAB_DB_SSL=false

# Downstream simulator
DOWNSTREAM_PORT=3001

# Client build only when not using Vite's local /api proxy
VITE_API_BASE_URL=http://localhost:3000
